# ==============================================================================
# MARAYA (المرايا) - Environment Configuration Template
# Duplicate this file to .env and populate with your environment credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Django Core Settings ---
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Frontend Integration ---
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL Database Configuration ---
POSTGRES_DB=maraya_db
POSTGRES_USER=maraya_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis & Celery Message Broker ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternative full connection string:
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- Google OAuth 2.0 (Social Authentication) ---
# Obtain these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Google Gemini AI Engine ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Local Speech-to-Text (Faster Whisper) ---
# Model sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
# Device: cpu or cuda
WHISPER_DEVICE=cpu

# --- Error Tracking & Observability (Optional) ---
SENTRY_DSN=

