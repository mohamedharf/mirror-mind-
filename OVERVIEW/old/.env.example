# ============================================================
# .env.example — انسخ هذا الملف لـ .env وعدّل القيم
# لا ترفع .env على GitHub أبداً
# ============================================================

# Django
SECRET_KEY=change-this-to-a-long-random-string-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (dev: SQLite / prod: PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://maraya:maraya_dev_pass@localhost:5432/maraya

# Google OAuth
# اذهب لـ https://console.cloud.google.com/apis/credentials
# أنشئ OAuth 2.0 Client ID (Web application)
# أضف http://localhost:8000/accounts/google/login/callback/ في Authorized redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Gemini API
# اذهب لـ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=http://localhost:5173

# Whisper
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
# غيّر لـ cuda لو عندك GPU: WHISPER_DEVICE=cuda
